@using HSP.Service.Dtos.EmailDto;
@model ResetPasswordDto
@{
  Layout = "/Views/Emails/_EmailLayout.cshtml";
}
<p>Chào @Model.FullName,</p>
<p>Bạn vừa yêu cầu đặt lại mật khẩu. Nhấn vào link bên dưới để tiếp tục:</p>
